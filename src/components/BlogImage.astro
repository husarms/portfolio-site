---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: string | ImageMetadata;
	alt: string;
	caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="my-8 not-prose">
	{
		typeof src === "string" ? (
			<img
				src={src}
				alt={alt}
				class="w-full rounded-xl shadow-sm object-cover"
				loading="lazy"
			/>
		) : (
			<Image
				src={src}
				alt={alt}
				class="w-full rounded-xl shadow-sm object-cover"
				loading="lazy"
			/>
		)
	}
	{
		caption && (
			<figcaption class="mt-2 text-center text-sm text-muted-foreground italic">
				{caption}
			</figcaption>
		)
	}
</figure>

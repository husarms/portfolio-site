---
import { siGithub, siInstagram } from 'simple-icons';

// Standard envelope path for email (not a brand icon)
const emailIconPath = "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z";
// LinkedIn was removed from simple-icons (C&D) — inlined from official brand assets
const linkedInIconPath = "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

const socials = [
	{ href: "mailto:hello@matthusar.com", label: "Email", iconPath: emailIconPath },
	{ href: "https://github.com/husarms", label: "GitHub", iconPath: siGithub.path },
	{ href: "https://linkedin.com/in/matthusar", label: "LinkedIn", iconPath: linkedInIconPath },
	{ href: "https://instagram.com/matthusar", label: "Instagram", iconPath: siInstagram.path },
];
---

<section id="contact" class="py-24 scroll-mt-16">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-bold tracking-wider text-primary uppercase mb-4">
				06 — Contact
			</p>
			<h2 class="text-4xl font-black tracking-tight mb-6">
				Let's talk.
			</h2>
			<p class="text-lg text-muted-foreground mb-10 leading-relaxed">
				Whether you have a project in mind, a job opportunity, or
				just want to say hi — my inbox is always open.
			</p>
			<div class="grid sm:grid-cols-2 gap-4">
				{
					socials.map((s) => (
						<a
							href={s.href}
							target={s.href.startsWith("mailto") ? undefined : "_blank"}
							rel={s.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
							class="flex items-center gap-3 p-4 rounded-xl border border-border hover:bg-muted transition-colors group"
						>
							<svg role="img" viewBox="0 0 24 24" class="w-5 h-5 fill-current shrink-0" aria-hidden="true">
								<path d={s.iconPath} />
							</svg>
							<span class="text-sm font-semibold group-hover:underline underline-offset-2">
								{s.label}
							</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="14"
								height="14"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
								class="ml-auto text-muted-foreground"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
							</svg>
						</a>
					))
				}
			</div>
		</div>
	</div>
</section>

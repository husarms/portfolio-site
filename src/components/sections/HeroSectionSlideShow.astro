---
import { Image } from "astro:assets";
import tokyoBg from "@/assets/index/tokyo-bg.jpg";
import sanFrancisco from "@/assets/blog/san-francisco/san-francisco-2.jpg";
import sakaiminato from "@/assets/blog/japan-part-1/japan-4.jpg";
import lasVegas from "@/assets/blog/las-vegas/las-vegas-1.jpg";

const slides = [
	{ image: tokyoBg, label: "Tokyo, Japan" },
	{ image: sanFrancisco, label: "San Francisco, USA" },
	{ image: sakaiminato, label: "Sakaiminato, Japan" },
	{ image: lasVegas, label: "Las Vegas, USA" },
];
---

<section
	class="relative min-h-[calc(100dvh-4rem)] flex items-center border-b border-border overflow-hidden"
>
	<!-- Slide images — stacked, cross-fade via opacity -->
	{
		slides.map((slide, i) => (
			<div
				class="slide absolute inset-0 transition-opacity duration-3000 ease-in-out"
				data-index={i}
				data-label={slide.label}
				aria-hidden={i !== 0 ? "true" : "false"}
			>
				<Image
					src={slide.image}
					alt={slide.label}
					widths={[800, 1200, 1600]}
					sizes="100vw"
					quality={85}
					class="w-full h-full object-cover"
					loading={i === 0 ? "eager" : "lazy"}
				/>
				<div class="absolute inset-0 bg-black/60" aria-hidden="true" />
			</div>
		))
	}

	<!-- Progress bar -->
	<div id="progress-bar" class="absolute top-0 left-0 h-1 bg-white/40 z-20" aria-hidden="true"></div>

	<!-- Dot grid overlay -->
	<div class="dot-overlay absolute inset-0 z-[1]" aria-hidden="true"></div>

	<!-- Content -->
	<div
		class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 w-full"
	>
		<div
			class="max-w-3xl rounded-2xl bg-black/40 backdrop-blur-xs border border-white/10 px-8 py-10 sm:px-12 sm:py-14"
		>
			<p
				class="text-sm font-medium tracking-widest text-white/70 uppercase mb-6 [text-shadow:0_2px_8px_rgba(0,0,0,0.6)]"
			>
				Software Engineer & Traveler
			</p>
			<h1
				class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tight leading-none mb-8 text-white [text-shadow:0_4px_16px_rgba(0,0,0,0.7)]"
			>
				Matt<br />Husar<span class="text-primary">.</span>
			</h1>
			<p
				class="text-xl text-white/80 max-w-lg mb-10 leading-relaxed [text-shadow:0_2px_8px_rgba(0,0,0,0.5)]"
			>
				I build scalable web products and document the world one trip at
				a time. Based in Miami.
			</p>
			<div class="flex flex-wrap gap-4">
				<a
					href="#experience"
					class="inline-flex items-center justify-center rounded-md bg-white text-black px-6 py-3 text-sm font-semibold hover:opacity-90 transition-opacity"
				>
					View my work
				</a>
				<a
					href="/blog"
					class="inline-flex items-center justify-center rounded-md border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
				>
					Travel blog →
				</a>
			</div>
		</div>
	</div>

	<!-- Location label -->
	<div
		class="absolute bottom-20 left-1/2 -translate-x-1/2 z-10 pointer-events-none"
	>
		<p
			id="slide-label"
			class="text-xs font-medium tracking-widest text-white/60 uppercase transition-opacity duration-500"
		>
			{slides[0].label}
		</p>
	</div>

	<!-- Dot navigation -->
	<div
		class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-2 z-10"
		role="tablist"
		aria-label="Slideshow navigation"
	>
		{
			slides.map((slide, i) => (
				<button
					class="dot h-2 rounded-full transition-all duration-300"
					data-dot={i}
					role="tab"
					aria-label={`Go to slide: ${slide.label}`}
				/>
			))
		}
	</div>

	<!-- Prev arrow -->
	<button
		id="slideshow-prev"
		class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-black/30 text-white flex items-center justify-center hover:bg-black/50 transition-colors"
		aria-label="Previous slide"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M15 19l-7-7 7-7"></path>
		</svg>
	</button>

	<!-- Next arrow -->
	<button
		id="slideshow-next"
		class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-black/30 text-white flex items-center justify-center hover:bg-black/50 transition-colors"
		aria-label="Next slide"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="16"
			height="16"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M9 5l7 7-7 7"></path>
		</svg>
	</button>

	<!-- Scroll indicator -->
	<div
		class="absolute bottom-8 right-8 z-10 animate-bounce"
		aria-hidden="true"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="20"
			height="20"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="2"
			class="text-white/40"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M19 9l-7 7-7-7"></path>
		</svg>
	</div>
</section>

<style>
	.dot-overlay {
		background-image: radial-gradient(circle, rgba(0, 0, 0, 0.35) 0.1px, transparent 1px);
		background-size: 3px 3px;
	}
	.slide {
		opacity: 0;
	}
	.slide.active {
		opacity: 1;
	}
	.dot {
		width: 0.5rem;
		background: rgba(255, 255, 255, 0.35);
	}
	.dot.active {
		width: 1.5rem;
		background: white;
	}
	#progress-bar {
		animation: progress 10s linear forwards;
	}
	@keyframes progress {
		from { width: 0%; }
		to { width: 100%; }
	}
</style>

<script>
	const slides = Array.from(document.querySelectorAll<HTMLElement>(".slide"));
	const dots = Array.from(document.querySelectorAll<HTMLElement>(".dot"));
	const label = document.getElementById("slide-label");
	const progressBar = document.getElementById("progress-bar");

	let current = 0;
	let timer: number;

	function resetProgress() {
		if (!progressBar) return;
		progressBar.style.animation = "none";
		progressBar.offsetHeight; // force reflow
		progressBar.style.animation = "progress 10s linear forwards";
	}

	function goTo(index: number) {
		slides[current].classList.remove("active");
		slides[current].setAttribute("aria-hidden", "true");
		dots[current].classList.remove("active");

		current = ((index % slides.length) + slides.length) % slides.length;

		slides[current].classList.add("active");
		slides[current].setAttribute("aria-hidden", "false");
		dots[current].classList.add("active");

		if (label) {
			label.style.opacity = "0";
			setTimeout(() => {
				label.textContent = slides[current].dataset.label ?? "";
				label.style.opacity = "1";
			}, 300);
		}

		resetProgress();
	}

	function startTimer() {
		timer = window.setInterval(() => goTo(current + 1), 10000);
	}

	function resetTimer() {
		clearInterval(timer);
		startTimer();
	}

	// Initialise first slide
	goTo(0);
	startTimer();

	dots.forEach((dot, i) => {
		dot.addEventListener("click", () => {
			goTo(i);
			resetTimer();
		});
	});

	document.getElementById("slideshow-prev")?.addEventListener("click", () => {
		goTo(current - 1);
		resetTimer();
	});
	document.getElementById("slideshow-next")?.addEventListener("click", () => {
		goTo(current + 1);
		resetTimer();
	});
</script>

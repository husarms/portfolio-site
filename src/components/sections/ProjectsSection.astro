---
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import portfolioImage from '@/assets/projects/portfolio-site.png';
import audioVisualizerImage from '@/assets/projects/audio-visualizer.png';
import coinSurferImage from '@/assets/projects/coin-surfer.png';

const projects = [
	{
		title: "Portfolio Site",
		description:
			"This site - personal portfolio and travel blog built with Astro and React. Features interactive travel map with vector tiles, dark mode, and responsive design. Deployed on Vercel.",
		tags: ["Astro", "React", "TypeScript", "Leaflet", "shadcn/ui", "MDX"],
		href: "https://github.com/husarms/portfolio-site",
		image: portfolioImage,
	},
	{
		title: "Audio Visualizer",
		description:
			"Winamp-style real-time audio visualizer featuring spectral bars, oscilloscope, MilkDrop-inspired radial patterns, and beat detection with reactive transitions.",
		tags: ["Svelte", "TypeScript", "Web Audio API", "Canvas", "DaisyUI"],
		href: "https://github.com/husarms/audio-visualizer",
		image: audioVisualizerImage,
	},
	{
		title: "Coin Surfer",
		description:
			"Open-source algorithmic cryptocurrency trading platform. Features customizable trading strategies, real-time market monitoring, visualization dashboard, and Coinbase integration.",
		tags: ["Trading Bot", "TypeScript", "Node.js", "React", "Cryptocurrency", "WebSockets"],
		href: "https://github.com/husarms/coin-surfer",
		image: coinSurferImage,
	},
];
---

<section id="projects" class="py-24 scroll-mt-16">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<p class="text-sm font-bold tracking-wider text-primary uppercase mb-4">
			05 — Projects
		</p>
		<h2 class="text-4xl font-black tracking-tight mb-14">
			What I've built.
		</h2>
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
			{
				projects.map((project) => (
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						class="group block"
					>
						<Card className="h-full hover:shadow-md transition-shadow duration-300 overflow-hidden">
							<img
								src={project.image.src}
								alt={project.title}
								class="w-full h-48 object-cover"
							/>
							<CardHeader>
								<div class="flex items-start justify-between">
									<CardTitle className="text-base group-hover:underline underline-offset-2">
										{project.title}
									</CardTitle>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
										class="text-muted-foreground shrink-0 mt-0.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M7 17L17 7M17 7H7M17 7v10"
										/>
									</svg>
								</div>
							</CardHeader>
							<CardContent className="flex flex-col gap-4">
								<CardDescription>{project.description}</CardDescription>
								<div class="flex flex-wrap gap-1.5 mt-auto">
									{project.tags.map((tag) => (
										<Badge variant="secondary" className="text-xs">
											{tag}
										</Badge>
									))}
								</div>
							</CardContent>
						</Card>
					</a>
				))
			}
		</div>
	</div>
</section>
